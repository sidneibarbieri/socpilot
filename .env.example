# Copy to .env and fill in credentials only on the execution machine. The
# controlled run reads the provider for each model from models.freeze.yaml.
OPENAI_API_KEY=replace-with-your-openai-key

# Local models require no credential. The run verifies their exact content
# digests before the first scientific task.
# OLLAMA_API_BASE=http://127.0.0.1:11434

# Optional credentials for a separate Azure OpenAI configuration. They are not
# used by the fixed campaign. A separate Azure study needs its own model
# registry and protocol manifest.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
